# Python caches
**/__pycache__/
**/*.pyc

# Virtual environments
mobile_version/.venv/
mobile_version/.venv-*/

# Secrets (anywhere in the repo). Keep *.env.example files tracked.
**/.env
**/.env.*
!**/.env.example
**/.streamlit/secrets.toml
**/blockbrain api.txt

# Temporary diagnostics
mobile_version/_pdf_text_diagnose.py
mobile_version/_rag_diag.py

# Local large model (keep local, do not push)
assets/models/*.gguf

# Editor/agent backup snapshots and runtime logs (clutter)
**/app.backup_*.py
**/app.py.bak_*
**/*.log
.title_dot_toggle

# Test / tooling caches
.pytest_cache/
